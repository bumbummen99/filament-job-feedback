// https://aka.ms/devcontainer.json
{
    "name": "Laravel Package FilamentJobFeedback (PHP 8.4)",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": "..",
        "args": {
            "PHP_VERSION": "8.4"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "ms-azuretools.vscode-containers",
                "github.vscode-github-actions"
            ],
            "settings": {}
        }
    },
    "forwardPorts": [8000],
    "remoteUser": "vscode"
}